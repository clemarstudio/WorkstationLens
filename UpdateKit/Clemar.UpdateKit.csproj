<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Version>0.1.0</Version>
    <PackageId>Clemar.UpdateKit</PackageId>
    <Description>Reusable lightweight updater orchestration for .NET desktop/localhost apps, powered by Velopack.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.2" />
    <EmbeddedResource Include="Web\update-banner.js" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
